{
  "schema_version": 2,
  "note": "规则卡：加规则只改本文件，不改代码。require_any = 必须出现的语法特征；scan_words = 从捕获串里往后找几个词定位真正的动词。",
  "cards": [
    {
      "id": "chtoby_past",
      "title_zh": "чтобы 从句里必须用过去时",
      "type": "tag_check",
      "level": "A2",
      "pattern": "(?:хочу|хочешь|хочет|хотим|хотите|хотят|хотел|хотела|хотелось)\\s*,?\\s*чтобы\\s+(?P<target>[а-яёА-ЯЁ]+(?:\\s+[а-яёА-ЯЁ]+){0,3})",
      "capture": "target",
      "scan_words": 5,
      "expect": { "POS": ["VERB", "INFN"] },
      "require_any": ["past"],
      "message_zh": "чтобы 后面要用过去时，不能用现在时或将来时。",
      "explain_zh": "чтобы 表示希望/要求/目的，俄语规定从句动词用过去时形式（与主语性数一致）。中文没有时态变化，所以最容易漏。",
      "wrong": "Я хочу, чтобы ты придёшь.",
      "right": "Я хочу, чтобы ты пришёл."
    },
    {
      "id": "chtoby_comma",
      "title_zh": "чтобы 前要加逗号",
      "type": "missing_token",
      "level": "A2",
      "pattern": "[а-яёА-ЯЁ]\\s+чтобы\\b",
      "message_zh": "чтобы 从句前缺逗号。",
      "explain_zh": "чтобы 引导的是从属句，前面必须用逗号与主句分开。",
      "wrong": "Я хочу чтобы ты пришёл.",
      "right": "Я хочу, чтобы ты пришёл."
    },
    {
      "id": "pomoch_dative",
      "title_zh": "помочь 的对象用与格",
      "type": "tag_check",
      "level": "A1",
      "pattern": "(?:помочь|помогать|помог|помогла|помоги|помогите)\\s+(?P<target>[а-яёА-ЯЁ]+)",
      "capture": "target",
      "expect": { "POS": ["NOUN", "NPRO", "ADJF"] },
      "require_any": ["datv"],
      "message_zh": "помочь 后面接与格（кому），不是宾格。",
      "explain_zh": "помочь кому 要求与格。中文「帮助某人」直接接宾语，所以常写成宾格。",
      "wrong": "Я хочу помочь тебя.",
      "right": "Я хочу помочь тебе."
    },
    {
      "id": "ne_khvataet_gen",
      "title_zh": "не хватает 后面用属格",
      "type": "tag_check",
      "level": "B1",
      "pattern": "не\\s+хватает\\s+(?P<target>[а-яёА-ЯЁ]+)",
      "capture": "target",
      "expect": { "POS": ["NOUN", "ADJF", "NPRO"] },
      "require_any": ["gent"],
      "message_zh": "не хватает 后面要求属格（чего）。",
      "explain_zh": "「缺少某物」是无人称结构 не хватает + 属格，没有主语，所以不能用主格。",
      "wrong": "Мне не хватает время.",
      "right": "Мне не хватает времени."
    },
    {
      "id": "zaviset_ot_gen",
      "title_zh": "зависеть от 后面用属格",
      "type": "tag_check",
      "level": "B1",
      "pattern": "завис(?:ит|ят|ел|ела|еть)\\s+от\\s+(?P<target>[а-яёА-ЯЁ]+)",
      "capture": "target",
      "expect": { "POS": ["NOUN", "NPRO", "ADJF"] },
      "require_any": ["gent"],
      "message_zh": "前置词 от 要求后面的词用属格。",
      "explain_zh": "зависеть от + 属格是固定支配；от 本身只能接属格。",
      "wrong": "Это зависит от погода.",
      "right": "Это зависит от погоды."
    },
    {
      "id": "nuzhno_inf",
      "title_zh": "нужно / надо 后面接不定式",
      "type": "tag_check",
      "level": "A2",
      "pattern": "(?:нужно|надо)\\s+(?P<target>[а-яёА-ЯЁ]+(?:\\s+[а-яёА-ЯЁ]+){0,1})",
      "capture": "target",
      "scan_words": 2,
      "expect": { "POS": ["INFN", "VERB"] },
      "require_any": ["INFN"],
      "message_zh": "нужно / надо 后面要用不定式（原形），不要按人称变位。",
      "explain_zh": "нужно + 不定式是无人称结构。中文「我需要去」会诱导写成 Я нужно иду。",
      "wrong": "Мне нужно иду.",
      "right": "Мне нужно идти."
    },
    {
      "id": "spasibo_dative",
      "title_zh": "спасибо 后面用与格",
      "type": "tag_check",
      "level": "A1",
      "pattern": "спасибо\\s+(?P<target>[а-яёА-ЯЁ]+)",
      "capture": "target",
      "expect": { "POS": ["NPRO", "NOUN", "ADJF"] },
      "require_any": ["datv"],
      "message_zh": "спасибо 后面要求与格（кому）。",
      "explain_zh": "спасибо тебе / спасибо большое。直接接主格是中国学生高频错。",
      "wrong": "Спасибо ты.",
      "right": "Спасибо тебе."
    },
    {
      "id": "igrat_v_acc",
      "title_zh": "играть в + 宾格（球类/游戏）",
      "type": "tag_check",
      "level": "A1",
      "pattern": "игра(?:ть|ю|ешь|ет|ем|ете|ют|л|ла|ли)\\s+в\\s+(?P<target>[а-яёА-ЯЁ]+)",
      "capture": "target",
      "expect": { "POS": ["NOUN"] },
      "require_any": ["accs"],
      "message_zh": "играть в + 宾格（玩什么）；играть на + 前置格（弹什么乐器）。",
      "explain_zh": "球类、游戏用 в + 宾格；乐器用 на + 前置格。中文都叫「玩/弹」。",
      "wrong": "Я играю в футболе.",
      "right": "Я играю в футбол."
    },
    {
      "id": "ya_imeyu",
      "title_zh": "「我有」不要说 я имею",
      "type": "phrase_replace",
      "level": "A1",
      "pattern": "\\bя\\s+имею\\b",
      "suggest": "у меня есть",
      "message_zh": "「我有」在俄语里说 у меня есть，不说 я имею。",
      "explain_zh": "这是英语 I have 的直译。俄语用 у + 属格 + есть 表示拥有。",
      "wrong": "Я имею машину.",
      "right": "У меня есть машина."
    },
    {
      "id": "uvazheniem",
      "title_zh": "正式书信结尾自动补全",
      "type": "snippet",
      "level": "B1",
      "pattern": "с\\s+уважением\\s*,?\\s*$",
      "suggest": "С уважением,\\n[Ваше имя]",
      "message_zh": "已插入正式书信结尾模板。",
      "explain_zh": "С уважением, + 换行 + 署名 是俄语正式邮件的标准结尾。",
      "wrong": "с уважением",
      "right": "С уважением,\nИван Петров"
    }
  ]
}
